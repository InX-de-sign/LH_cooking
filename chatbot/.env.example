# =============================================================================
# LH_cooking settings. Copy to chatbot/.env and fill in the two slots below.
#
# Both slots may be left empty: the coach still runs, reading recipe steps
# and notes back without an AI model, so the app can be tested first.
# After editing, restart the server. GET /health shows what is live.
# =============================================================================


# --- SLOT 1: chat model (the coach's voice) --------------------------------
# An Azure OpenAI deployment. Writes every reply, using the recipe notes and
# whatever the camera reported.
#
#   OPENAI_API_KEY          the Azure subscription key
#   AZURE_OPENAI_ENDPOINT   e.g. https://hkust.azure-api.net
#   AZURE_DEPLOYMENT_NAME   the deployment to use, e.g. gpt-5-mini or gpt-4o-mini
#                           (gpt-5 and gpt-4o families take different
#                           parameters; config.py handles both by name)
#   AZURE_OPENAI_API_VERSION  keep 2024-10-21 for the HKUST proxy
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://hkust.azure-api.net
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21


# --- SLOT 2: vision model (the coach's eyes) -------------------------------
# Looks at the phone's camera frame when a question needs it ("is this
# done?") and describes what it sees. Never talks to the cook directly.
#
#   VLM_PROVIDER=none               camera preview only, no understanding
#   VLM_PROVIDER=azure              an image-capable Azure deployment on the
#                                   SAME endpoint and key as slot 1; just set
#                                   VLM_MODEL to its deployment name
#   VLM_PROVIDER=openai_compatible  any other OpenAI-style endpoint (Tencent
#                                   Hunyuan, Qwen-VL, ...); also needs
#                                   VLM_BASE_URL and VLM_API_KEY
VLM_PROVIDER=none
VLM_MODEL=
VLM_BASE_URL=
VLM_API_KEY=

# When to look: auto = only questions that need eyes; always = every question
# that arrives with a camera frame.
VLM_MODE=auto
