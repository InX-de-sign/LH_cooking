# Public DNS name pointing to the Lighthouse public IP. Do not include https://.
# A real domain is required: phones only allow camera and microphone access
# over HTTPS, and Caddy gets the certificate for this name.
DOMAIN=cook.example.com

# --- Chat model: Azure OpenAI (HKUST proxy) ---------------------------------
OPENAI_API_KEY=replace_with_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://hkust.azure-api.net
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_TIMEOUT_SECONDS=30

# --- Vision model (see chatbot/vision.py) -----------------------------------
VLM_PROVIDER=none
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_MODE=auto
VLM_TIMEOUT_SECONDS=10

WEB_SEARCH_ENABLED=true
AZURE_RESPONSES_BASE_URL=
WEB_SEARCH_TIMEOUT_SECONDS=60
